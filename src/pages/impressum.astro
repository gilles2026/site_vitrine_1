  }
  .subtitle { font-size: 14px; color: #6d6577; margin-bottom: 40px; font-style: italic; }
  h2 {
    font-family: 'Playfair Display', serif; font-weight: 500; font-size: 19px;
    color: var(--ink); margin-top: 32px; margin-bottom: 8px;
  }
  p { margin-bottom: 4px; }
  .tbc { color: var(--rose); font-style: italic; }
  .back-link { display: inline-block; margin-top: 48px; font-size: 14px; }
  hr { border: none; border-top: 1px solid var(--line); margin: 40px 0; }
</style>
