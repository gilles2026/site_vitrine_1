    max-width: var(--max-w); margin: 0 auto; display: block;
  }
  main { max-width: var(--max-w); margin: 0 auto; padding: 64px 32px 96px; }
  h1 {
    font-family: 'Playfair Display', serif; font-weight: 500; font-size: 34px;
